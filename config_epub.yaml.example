# ==============================================================================
# EPUB 高保真翻译配置模版 (Subagent 协同流水线)
# ==============================================================================
title: "Your Book Title"
input_epub: "input/your_book.epub"

# 语言设置
translation:
  source_language: English # 或 Japanese / French 等
  target_language: Chinese

# Antigravity Subagent 模型（只作为 IDE 子 Agent 的任务提示，不调用任何 API）
# 正文、元数据和目录翻译默认使用 Pro；其他任务默认使用 Flash。
subagent:
  models:
    translation: gemini-3.1-pro-preview
    default: gemini-3.6-flash
  # Subagent 批处理建议；长文件仍应按完整翻译单元拆分。
  batching:
    max_files: 5
    max_source_tokens: 12000
    max_concurrency: 3
  # 可选的单任务覆盖：
  # task_models:
  #   translate-html: gemini-3.1-pro-preview

# EPUB 构建与校验选项
html_translation:
  epubcheck_mode: warn # 可选: warn / off / strict
  # html-prepare creates metadata_translation_source.json. The Subagent writes
  # translated_metadata.json; html-validate checks it before packaging.
