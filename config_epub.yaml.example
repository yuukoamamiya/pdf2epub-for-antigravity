# ==============================================================================
# EPUB 高保真翻译配置模版 (Subagent 协同流水线)
# ==============================================================================
title: "Your Book Title"
input_epub: "input/your_book.epub"

# 语言设置
translation:
  source_language: English # 或 Japanese / French 等
  target_language: Chinese
  # EPUB 默认也会先提取当前书的实体术语，保证全书译名一致。
  # 需要时可显式跳过：html-prepare --skip-entities
  require_entities: true
  # 外部领域术语表是按书选择的，可不填；可同时选择多个 YAML/JSON 术语表。
  # glossaries:
  #   - path: "glossaries/german-classical-philosophy.yaml"
  #     id: german-classical-philosophy

# Antigravity Subagent 模型（只作为 IDE 子 Agent 的任务提示，不调用任何 API）
# 默认使用 inherit，让子 Agent 继承主会话已验证的模型；需要固定模型时再显式填写。
# 翻译任务依次读取 task_models -> models.translation -> models.default；
# 其他任务依次读取 task_models -> models.default。
subagent:
  models:
    translation: inherit
    default: inherit
  # Subagent 批处理建议；长文件仍应按完整翻译单元拆分。
  batching:
    max_files: 5
    max_source_tokens: 12000
    max_concurrency: 3
    # Pack adjacent short TOC branches into one worker while preserving
    # per-chapter terminology scopes.
    pack_adjacent_chapters: true
    max_chapters_per_worker: 3
    # 可选：允许极短特殊单元彼此共用 worker；特殊单元仍不与普通章节混排。
    pack_tiny_special_units: false
  # 可选的单任务覆盖：
  # task_models:
  #   translate-html: gemini-3.1-pro-preview

# EPUB 构建与校验选项
html_translation:
  epubcheck_mode: warn # 可选: warn / off / strict
  # html-prepare creates metadata_translation_source.json. The Subagent writes
  # translated_metadata.json; html-validate checks it before packaging.
