# ==============================================================================
# PDF 转 EPUB / 精修 / 翻译配置模版 (Subagent 协同流水线)
# ==============================================================================
title: "Your Book Title"
input_pdf: "input/your_book.pdf"

# 语言设置
translation:
  source_language: English # 或 Japanese / German / French 等
  target_language: Chinese
  # PDF 翻译前要求先生成并校验统一术语表；确实不需要时可在 translate 中使用 --skip-entities。
  require_entities: true
  # 外部领域术语表是按书选择的，可不填；可同时选择多个 YAML/JSON 术语表。
  # glossaries:
  #   - path: "glossaries/german-classical-philosophy.yaml"
  #     id: german-classical-philosophy
  # auto 会使用通过校验的 polished_markdown/validated。原生文本 PDF 只跳过视觉 OCR，
  # 仍需经过 polish 来识别软换行和真实段落；可显式填写 polished 或 ocr。
  source_stage: auto

# 可选：手动覆盖书名页提取的书目信息
# metadata:
#   author: "Author Name"
#   publisher: "Publisher Name"

# Antigravity Subagent 模型（只作为 IDE 子 Agent 的任务提示，不调用任何 API）
# 翻译类任务默认使用 Pro，其余任务（结构分析、润色、实体提取）默认使用 Flash。
subagent:
  models:
    translation: gemini-3.1-pro-preview
    default: gemini-3.6-flash
  # Subagent 批处理建议；仅生成 manifest 和提示，不由 Python 自动调用模型。
  batching:
    max_files: 5
    max_source_tokens: 12000
    # Units larger than this are always assigned to a single Subagent.
    single_file_max_bytes: 30000
    max_concurrency: 3
  # 可选：按任务覆盖上面的默认值，例如 refine / polish / translate-html。
  # task_models:
  #   refine: gemini-3.6-flash

# OCR 设置 (默认 chandra，支持多模态 OCR)
ocr:
  backend: chandra
  furigana_mode: attach # 日语振假名: attach / remove / ruby
  backends:
    chandra:
      base_url: https://chandra.shenshei.fans/v1
      model: chandra
      max_workers: 4
      dpi: 192
      min_dimension: 1024
      include_headers_footers: false
      access_client_id_env: CHANDRA_CF_ACCESS_CLIENT_ID
      access_client_secret_env: CHANDRA_CF_ACCESS_CLIENT_SECRET
      request_timeout: 300
      max_retries: 6

# Refine 与结构自愈设置
refine:
  # TOC analysis is done by an Antigravity workspace subagent.
  max_tokens: 8000
  # Split every very large refined unit after merging. Content roles such as
  # notes/bibliography/index are assigned by the TOC Subagent, not here.
  # The split files use the existing chapter_N.partM.md contract.
  oversized_unit_split:
    enabled: true
    threshold_tokens: 15000
    target_tokens: 12000
