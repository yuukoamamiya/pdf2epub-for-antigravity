# ==============================================================================
# PDF 转 EPUB / 精修 / 翻译配置模版 (Subagent 协同流水线)
# ==============================================================================
# 公共默认（pipeline / OCR / 脚注 / Subagent 批处理 / refine）来自 config.base.yaml。
# 顶层键浅合并：本文件声明了哪个顶层键，就整体替换基文件里的同名键。
base: config.base.yaml

title: "Your Book Title"
input_pdf: "input/your_book.pdf"
author: "Author Name"

# Optional language-neutral PDF -> EPUB conversion. With this mode, entity
# extraction, translated TOC, and translation-only readiness gates are skipped;
# the validated original-language Markdown is packaged directly. The polish
# gate remains required for every PDF pipeline. Override the base pipeline:
# pipeline: epub_conversion
# (The legacy alias mode: ocr_to_epub is also accepted.)
# For conversion-only use, the minimal configuration is:
# base: config.base.yaml
# title: "Your Book Title"
# input_pdf: "input/your_book.pdf"
# pipeline: epub_conversion

# 语言设置
translation:
  source_language: English # 或 Japanese / German / French 等
  target_language: Chinese
  # PDF 翻译前要求先生成并校验统一术语表；确实不需要时可在 translate 中使用 --skip-entities。
  require_entities: true
  # 外部领域术语表是按书选择的，可不填；可同时选择多个 YAML/JSON 术语表。
  # glossaries:
  #   - path: "glossaries/german-classical-philosophy.yaml"
  #     id: german-classical-philosophy
  # 跨语言术语表只能作为只读参考，不参与正式术语优先级，也不会被自动修改：
  # reference_glossaries:
  #   - path: "glossaries/german-classical-philosophy.yaml"
  #     id: german-classical-philosophy
  # auto 会选择当前通过校验的 polished_markdown/validated；ocr/native_text 仅为旧配置
  # 兼容和诊断保留，不能通过普通翻译或打包门禁。
  source_stage: auto

# 可选：手动覆盖书名页提取的书目信息
# metadata:
#   publisher: "Publisher Name"

# 单书覆盖示例（默认值见 config.base.yaml）：
# subagent:
#   models:
#     translation: gemini-4-hydrogen
#     default: gemini-3.8-flash
#   batching:
#     max_files: 8
#     max_source_tokens: 15000
#     max_concurrency: 4
#   task_models:
#     refine: gemini-4-hydrogen
#     footnote-prepare: gemini-4-hydrogen
#     polish: gemini-3.8-flash
#     extract-entities: gemini-3.8-flash
#     illustration-prepare: gemini-3.8-flash
