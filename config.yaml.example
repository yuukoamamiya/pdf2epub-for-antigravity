# ==============================================================================
# PDF 转 EPUB / 精修 / 翻译配置模版 (Subagent 协同流水线)
# ==============================================================================
title: "Your Book Title"
input_pdf: "input/your_book.pdf"

# Optional language-neutral PDF -> EPUB conversion.  With this mode, entity
# extraction, translated TOC, and translation-only readiness gates are skipped;
# the validated original-language Markdown is packaged directly.  The polish
# gate remains required for every PDF pipeline.
# pipeline: epub_conversion
# (The legacy alias mode: ocr_to_epub is also accepted.)
# For conversion-only use, the minimal configuration is just:
# title: "Your Book Title"
# input_pdf: "input/your_book.pdf"
# pipeline: epub_conversion

# 语言设置
translation:
  source_language: English # 或 Japanese / German / French 等
  target_language: Chinese
  # PDF 翻译前要求先生成并校验统一术语表；确实不需要时可在 translate 中使用 --skip-entities。
  require_entities: true
  # 外部领域术语表是按书选择的，可不填；可同时选择多个 YAML/JSON 术语表。
  # glossaries:
  #   - path: "glossaries/german-classical-philosophy.yaml"
  #     id: german-classical-philosophy
  # 跨语言术语表只能作为只读参考，不参与正式术语优先级，也不会被自动修改：
  # reference_glossaries:
  #   - path: "glossaries/german-classical-philosophy.yaml"
  #     id: german-classical-philosophy
  # 通常保持 auto：它会选择当前通过校验的 polished_markdown/validated。原生文本 PDF 只跳过
  # 视觉 OCR，仍需经过 polish 来识别软换行和真实段落；polished 可用于显式要求该阶段。
  # ocr/native_text 仅为旧配置兼容和原始阶段诊断保留，不能通过普通翻译或打包门禁，不要用于
  # 正常翻译/构建流程。
  source_stage: auto

# 可选：手动覆盖书名页提取的书目信息
# metadata:
#   author: "Author Name"
#   publisher: "Publisher Name"

# Antigravity Subagent 模型（只作为 IDE 子 Agent 的任务提示，不调用任何 API）
# 翻译类任务默认使用 Pro，其余任务（结构分析、润色、实体提取）默认使用 Flash。
subagent:
  models:
    translation: gemini-3.1-pro-preview
    default: gemini-3.6-flash
  # Subagent 批处理建议；仅生成 manifest 和提示，不由 Python 自动调用模型。
  batching:
    max_files: 5
    max_source_tokens: 12000
    # Units larger than this are always assigned to a single Subagent.
    single_file_max_bytes: 30000
    max_concurrency: 3
    # Pack adjacent short top-level chapters into one worker while preserving
    # per-chapter terminology scopes.
    pack_adjacent_chapters: true
    max_chapters_per_worker: 3
  # 可选：按任务覆盖上面的默认值，例如 refine / polish / translate-html。
  # task_models:
  #   refine: gemini-3.6-flash

# 本地凭据目录（整个目录已加入 .gitignore；不要把密钥写入 YAML）
credentials:
  local_dir: .secrets

# OCR 设置 (默认 chandra，支持多模态 OCR)
ocr:
  backend: chandra
  furigana_mode: attach # 日语振假名: attach / remove / ruby
  # 可选的第二套 OCR。开启后逐页生成结果和共识报告，并把差异交给 Subagent 复核。
  secondary:
    enabled: false
    # 双 OCR 会在第 1 页前估算总耗时；超过此阈值时先暂停，不会静默退回单 OCR。
    performance:
      max_estimated_seconds: 3600
      estimated_seconds_per_page: 5.0
  consensus:
    common_miss:
      sample_every: 20
      density_ratio: 0.30
      min_neighbor_chars: 800
  backends:
    chandra:
      base_url: https://chandra.shenshei.fans/v1
      model: chandra
      max_workers: 4
      dpi: 192
      min_dimension: 1024
      include_headers_footers: false
      credentials_file: chandra-access.json
      request_timeout: 300
      max_retries: 6

# 脚注候选的本地高置信度接受策略；false 时扫描/OCR 和原生文字 PDF 都交给 Subagent 复核。
footnotes:
  auto_accept: false
  # The block lower edge must enter this bottom band, and at least this share
  # of the block height must intersect the band.
  bottom_ratio: 0.64
  bottom_intersection_ratio: 0.25
  # 原生文字 PDF 的字号证据门槛；只影响 native layout 候选。
  native_max_font_ratio: 0.88

# 整页彩页/插页复核（只影响疑似候选页，不会自动把普通插图移位）
illustration:
  review_dpi: 150
  large_block_area: 0.55
  max_text_chars: 180

# Refine 与结构自愈设置
refine:
  # TOC analysis is done by an Antigravity workspace subagent.
  max_tokens: 8000
  # Split every very large refined unit after merging. Content roles such as
  # notes/bibliography/index are assigned by the TOC Subagent, not here.
  # The split files use the existing chapter_N.partM.md contract.
  oversized_unit_split:
    enabled: true
    threshold_tokens: 15000
    target_tokens: 12000
